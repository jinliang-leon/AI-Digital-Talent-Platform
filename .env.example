# 本机开发配置示例：复制为 .env 后填写，不提交真实凭据
APP_NAME=AI数字化人才平台
APP_ENV=development
PROJECT_NAMESPACE=ai_talent_v1
DATABASE_URL=mysql+pymysql://talent_user:请填写密码@127.0.0.1:3306/ai_digital_talent?charset=utf8mb4
JWT_SECRET=请生成至少32字符的随机签名密钥
REDIS_URL=redis://127.0.0.1:6379/9
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=请填写
MINIO_SECRET_KEY=请填写
MINIO_BUCKET=ai-talent-resumes
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=请填写
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_MODEL=xingchen/spark-x2.6
LLM_API_KEY=请填写本机模型网关密钥
LLM_TIMEOUT_SECONDS=90
LLM_THINKING_MODE=disabled
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_DIMENSION=1024
# 测试必须使用独立库；不得指向演示或真实业务数据库
TEST_DATABASE_URL=mysql+pymysql://talent_user:请填写密码@127.0.0.1:3306/ai_digital_talent_test?charset=utf8mb4
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=请填写至少10字符的初始管理员密码
TASK_TIMEOUT=600
WORKER_STALE_SECONDS=720
